# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
POSTGRES_VERSION=15
DB_USER=mlflow
DB_PASSWORD=your-db-password-url-encoded
DB_NAME=mlflow
DB_PORT=5432

# ──────────────────────────────────────────────
# MinIO Object Storage
# ──────────────────────────────────────────────
MINIO_VERSION=latest
MINIO_MC_VERSION=latest
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your-minio-password

# ──────────────────────────────────────────────
# MLflow Server
# ──────────────────────────────────────────────
MLFLOW_VERSION=3.10.1
MLFLOW_PORT=80
MLFLOW_S3_BUCKET=mlflow
MLFLOW_AUTH_ADMIN_USERNAME=admin
MLFLOW_AUTH_ADMIN_PASSWORD=your-admin-password
MLFLOW_FLASK_SERVER_SECRET_KEY=your-flask-secret-key

# ──────────────────────────────────────────────
# Portal / Authentication
# ──────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key

# ──────────────────────────────────────────────
# OIDC Single Sign-On (leave empty to disable)
# ──────────────────────────────────────────────
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost/entry/callback
OIDC_ADMIN_USER=
